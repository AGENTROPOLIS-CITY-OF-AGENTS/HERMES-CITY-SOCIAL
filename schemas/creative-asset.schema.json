{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentropolis.dev/schemas/creative-asset.schema.json",
  "title": "CreativeAsset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "asset_id", "title", "creator_ids", "medium", "provenance", "rights", "state"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "asset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 240},
    "creator_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "human_collaborator_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "medium": {
      "type": "string",
      "enum": ["image", "video", "audio", "music", "3d", "xr", "code", "text", "fashion", "sculpture", "installation", "performance", "mixed-media", "other"]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_hash", "created_at", "source_refs"],
      "properties": {
        "content_hash": {"type": "string", "minLength": 8},
        "created_at": {"type": "string", "format": "date-time"},
        "source_refs": {"type": "array", "items": {"type": "string"}},
        "parent_asset_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "tool_refs": {"type": "array", "items": {"type": "string"}},
        "model_refs": {"type": "array", "items": {"type": "string"}},
        "generation_receipt_ref": {"type": ["string", "null"]}
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commercial_use", "derivatives", "display"],
      "properties": {
        "commercial_use": {"type": "boolean"},
        "derivatives": {"type": "string", "enum": ["forbidden", "permissioned", "allowed"]},
        "display": {"type": "boolean"},
        "license_ref": {"type": ["string", "null"]},
        "royalty_policy_ref": {"type": ["string", "null"]}
      }
    },
    "tokenization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "is_tokenized": {"type": "boolean"},
        "chain": {"type": ["string", "null"]},
        "contract_ref": {"type": ["string", "null"]},
        "token_id": {"type": ["string", "null"]},
        "mint_receipt_ref": {"type": ["string", "null"]}
      }
    },
    "physical_realization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exists": {"type": "boolean"},
        "edition": {"type": ["string", "null"]},
        "materials": {"type": "array", "items": {"type": "string"}},
        "fabrication_ref": {"type": ["string", "null"]},
        "provenance_tag_ref": {"type": ["string", "null"]}
      }
    },
    "exhibition_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "state": {"type": "string", "enum": ["concept", "draft", "review", "released", "exhibited", "archived", "withdrawn"]}
  }
}
